export type MeshStreamMimeType = 'm3u8' | 'mpd' | 'mp4' | 'mp3'

export type MeshStreamConfig = {
  key: string
  p2pEnabled?: boolean
}

export type PlaybackSessionOptions = {
  url: string
  contentId?: string
  mimeType?: MeshStreamMimeType
  originHeaders?: UTSJSONObject
}

export type MeshStreamPlaybackMode = 'NATIVE_P2P' | 'NATIVE_CDN'

export type MeshStreamUnavailableReason =
  | 'OK'
  | 'ACCOUNT_DISABLED'
  | 'APP_DISABLED'
  | 'APP_NOT_FOUND'
  | 'KEY_DISABLED'
  | 'PLATFORM_DISABLED'
  | 'ORIGIN_DENIED'
  | 'PACKAGE_DENIED'
  | 'BUNDLE_DENIED'
  | 'SIGNING_CERT_DENIED'
  | 'TEAM_DENIED'
  | 'AUTH_FAILED'
  | 'CONFIG_UNAVAILABLE'
  | 'TRACKER_ERROR'
  | 'NO_PEERS'
  | 'UNSUPPORTED'
  | 'INITIALIZATION_FAILED'
  | 'DISABLED'
  | 'KEY_P2P_DISABLED'
  | 'QUOTA_EXHAUSTED'
  | 'QUOTA_DISABLED'

export type MeshStreamStatus = UTSJSONObject
export type MeshStreamStats = UTSJSONObject
export type MeshStreamDiagnostics = UTSJSONObject
export type MeshStreamEvent = UTSJSONObject
export type MeshStreamEventListener = (event: MeshStreamEvent) => void
